FROM node:24-alpine AS base

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS dependencies

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --include=optional \
    && node -e "const sharp = require('sharp'); console.log('sharp/libvips', sharp.versions.sharp, sharp.versions.vips)"

FROM dependencies AS builder

COPY . .
RUN npm run db:generate

# El build no consulta MariaDB. Las variables reales se inyectan al ejecutar.
ENV NODE_ENV=production
ENV USE_DATABASE=false
ENV DATABASE_URL=mysql://build:build@127.0.0.1:3306/build
RUN npm run build

FROM dependencies AS migrator

COPY . .
RUN npm run db:generate

CMD ["npm", "run", "db:deploy"]

FROM base AS runner

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

RUN mkdir -p uploads .next/cache \
    && chown -R nextjs:nodejs uploads .next

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
