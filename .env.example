# Copia este archivo a `.env` y ajusta los valores.

# MariaDB del Compose de servicios generales.
# Desde el host usa 127.0.0.1; dentro de Docker se usa el alias `database`.
DATABASE_URL="mysql://root:docker@127.0.0.1:3306/project-variedadeslosprimos"
DATABASE_URL_DOCKER="mysql://root:docker@database:3306/project-variedadeslosprimos"
HOST_MACHINE_APP_PORT="3000"

# "false" -> UI con datos mock (sin DB).  "true" -> UI lee desde MariaDB.
USE_DATABASE="true"

# Secreto para firmar la cookie de sesión (JWT). Usa un valor largo y aleatorio.
SESSION_SECRET="cambia-este-secreto"

# Ponlo en "true" solo al desplegar detrás de HTTPS (marca las cookies Secure).
COOKIE_SECURE="false"

# Base pública de la app: dominio con el que se arman los enlaces de los correos
# (p.ej. el de recuperación de contraseña). En producción, tu dominio con https://.
APP_URL="http://localhost:3000"

# --- Envío de correo por SMTP (recuperación de contraseña y correos de pedido) ---
# Mientras falte SMTP_HOST o SMTP_PASS, en desarrollo el correo NO se envía: se
# imprime en la consola del servidor para poder probar el flujo.
#
# Con Gmail:
#   1. Activa la verificación en 2 pasos en tu cuenta de Google.
#   2. Crea una "contraseña de aplicación": https://myaccount.google.com/apppasswords
#   3. Ponla en SMTP_PASS (16 caracteres). SMTP_USER es tu correo.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Remitente que verá el destinatario. Con Gmail, usa tu mismo correo.
EMAIL_FROM="Variedades Los Primos <tucorreo@gmail.com>"
# Buzón del equipo: aquí llegan los avisos de Contáctanos, PQR y pedidos nuevos
# (además de la campana del panel). Si se deja vacío, se usa SMTP_USER.
STORE_EMAIL="variedadeslosprimosc0l@gmail.com"

# --- Pagos con Wompi (https://comercios.wompi.co → Desarrolladores) ---
# El ambiente se deduce del prefijo de la llave: pub_test_/prv_test_ = sandbox
# (pagos de prueba, sin dinero real), pub_prod_/prv_prod_ = producción.
# La llave privada y los dos secretos NUNCA deben salir del servidor.
# Además, configura en el panel de Wompi la "URL de eventos" apuntando a
# https://<tu-dominio-o-túnel>/api/webhooks/wompi
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
