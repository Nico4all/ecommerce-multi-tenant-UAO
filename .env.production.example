# Copia este archivo como `.env.production` en el servidor.

# MariaDB existente dentro de la red externa apps_mind_net.
DATABASE_URL_DOCKER="mysql://USUARIO:CONTRASENA@mariadblts:3306/project-variedadeslosprimos"

# Puerto local del servidor. Nginx también puede usar el upstream
# `variedades-los-primos-app:3000` directamente dentro de apps_mind_net.
HOST_MACHINE_APP_PORT="3004"

USE_DATABASE="true"
SESSION_SECRET="GENERA_UN_SECRETO_LARGO_Y_ALEATORIO"
COOKIE_SECURE="true"
APP_URL="https://variedadeslosprimoscol.com"

# OAuth de Google (opcional).
# Origen: https://variedadeslosprimoscol.com
# Redirect: https://variedadeslosprimoscol.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Correo SMTP.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Variedades Los Primos <tucorreo@gmail.com>"
STORE_EMAIL=""

# Wompi.
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
