// Variedades Los Primos — Modelo de datos completo.
// Documentación y decisiones: docs/modelo-de-datos.md
// Convención: enums en inglés (la UI los traduce a español).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Identidad global; propiedad comercial y permisos por tienda.
model Store {
  id                        String               @id @default(cuid())
  slug                      String               @unique
  name                      String
  active                    Boolean              @default(false)
  legacyKey                 String?              @unique
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  domains                   StoreDomain[]
  memberships               StoreMembership[]
  settings                  StoreSettings?
  categoryRecords           Category[]
  productRecords            Product[]
  productImageRecords       ProductImage[]
  productSpecRecords        ProductSpec[]
  productVariantRecords     ProductVariant[]
  reviewRecords             Review[]
  cartRecords               Cart[]
  cartItemRecords           CartItem[]
  wishlistItemRecords       WishlistItem[]
  orderRecords              Order[]
  orderItemRecords          OrderItem[]
  orderStatusEventRecords   OrderStatusEvent[]
  paymentRecords            Payment[]
  discountCodeRecords       DiscountCode[]
  discountRedemptionRecords DiscountRedemption[]
  bannerRecords             Banner[]
  homeSectionRecords        HomeSection[]
  emailLogRecords           EmailLog[]
  notificationRecords       Notification[]
  supportMessageRecords     SupportMessage[]
  passwordResetTokens       PasswordResetToken[]
  oauthAttempts             OAuthAttempt[]

  @@map("stores")
}

model StoreDomain {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  hostname   String    @unique @db.VarChar(253)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([storeId])
  @@map("store_domains")
}

enum StoreRole {
  OWNER
  ADMIN
  CUSTOMER
}

model StoreMembership {
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      StoreRole @default(CUSTOMER)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@id([storeId, userId])
  @@index([userId])
  @@map("store_memberships")
}

model StoreSettings {
  storeId   String   @id
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  currency  String   @default("COP") @db.VarChar(3)
  locale    String   @default("es-CO") @db.VarChar(10)
  senderEmail       String? @db.VarChar(254)
  notificationEmail String? @db.VarChar(254)
  contactEmail      String? @db.VarChar(254)
  emailLogoUrl      String? @db.VarChar(2048)
  seoDescription    String? @db.VarChar(500)
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

// ═══════════════════════════ Usuarios ═══════════════════════════

enum Role {
  ADMIN
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  passwordHash    String? // null si inicia sesión con proveedor social
  sessionVersion  Int     @default(0)
  /// `sub` de Google (estable aunque el usuario cambie de correo). null = nunca
  /// ha entrado con Google.
  googleId        String?    @unique @db.VarChar(255)
  phone           String?
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  /// Cuándo aceptó los Términos y la Política de datos personales. `null` en
  /// cuentas creadas antes de que existiera esta casilla (admin/seed antiguos).
  termsAcceptedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  addresses   Address[]
  orders      Order[]
  reviews     Review[]
  wishlist    WishlistItem[]
  carts       Cart[]
  memberships StoreMembership[]
  redemptions DiscountRedemption[]
  emails      EmailLog[]
  support     SupportMessage[]
  resetTokens PasswordResetToken[]
  oauthAttempts OAuthAttempt[]

  @@map("users")
}

/// Token de recuperación de contraseña.
///
/// Se guarda HASHEADO (sha-256), nunca en claro: si se filtra la BD, el enlace
/// enviado por correo no se puede reconstruir. Un solo uso (`usedAt`) y caduca
/// (`expiresAt`, 1 hora). El barrido de vencidos es perezoso: se ignoran al
/// validar y se sobrescriben al pedir uno nuevo.
model PasswordResetToken {
  storeId   String @default("store-original")
  store     Store @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessionVersion Int @default(0)
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([storeId, userId])
  @@map("password_reset_tokens")
}

model OAuthAttempt {
  stateHash String @id @db.Char(64)
  storeId   String
  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([storeId, expiresAt])
  @@index([userId])
  @@map("oauth_attempts")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  street    String
  city      String
  state     String
  zip       String
  country   String  @default("Colombia")
  phone     String?
  reference String? // referencias de entrega ("entre calles…")
  isDefault Boolean @default(false)

  @@index([userId])
  @@map("addresses")
}

// ═══════════════════════════ Catálogo ═══════════════════════════

model Category {
  storeId      String        @default("store-original")
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  slug         String
  name         String
  icon         String // nombre de icono Lucide
  gradient     String // clases tailwind del tile
  imageUrl     String? // imagen/SVG propia (si existe, reemplaza al icono)
  description  String?       @db.Text
  products     Product[]
  homeSections HomeSection[]

  @@id([storeId, slug])
  @@map("categories")
}

enum ProductStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

model Product {
  storeId     String        @default("store-original")
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id          String        @id @default(cuid())
  slug        String
  name        String
  brand       String
  description String?       @db.Text
  sku         String?
  status      ProductStatus @default(PUBLISHED)
  featured    Boolean       @default(false)
  badge       String? // "Más vendido", "2+1 Gratis"…

  /// Costo de envío propio de este producto (anula la tarifa general de la
  /// tienda para el pedido: ver `shippingFor` en lib/shipping.ts).
  /// `null` = usa la tarifa general (gratis sobre el umbral, si no $15.000).
  /// `0`    = este producto siempre envía gratis.
  /// `> 0`  = costo fijo propio (p.ej. un mueble pesado con flete especial).
  shippingCost Decimal? @db.Decimal(10, 2)

  // Precios: `price` es el precio base. La oferta la gestiona el admin
  // (/admin/offers) con `offerPrice` + `offerActive`.
  price       Decimal  @db.Decimal(10, 2)
  offerPrice  Decimal? @db.Decimal(10, 2)
  offerActive Boolean  @default(false)

  /// Costo del producto (lo que nos cuesta) para calcular ganancias. Interno:
  /// NUNCA se envía a la tienda, solo al panel. `null` = sin costo registrado.
  cost Decimal? @db.Decimal(10, 2)

  // Stock general; si el producto tiene variantes, el stock vive en ellas.
  stock Int @default(0)

  // Agregados de reseñas (cache derivada de Review, se recalcula al reseñar).
  ratingAvg   Decimal @default(0) @db.Decimal(2, 1)
  reviewCount Int     @default(0)

  categorySlug String
  category     Category @relation(fields: [storeId, categorySlug], references: [storeId, slug], onDelete: Restrict, onUpdate: Restrict)

  images       ProductImage[]
  specs        ProductSpec[]
  variants     ProductVariant[]
  reviews      Review[]
  cartItems    CartItem[]
  wishlistedBy WishlistItem[]
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@unique([storeId, id])
  @@index([storeId, categorySlug])
  @@index([status])
  @@map("products")
}

model ProductImage {
  storeId   String  @default("store-original")
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([storeId])
  @@index([productId])
  @@map("product_images")
}

model ProductSpec {
  storeId   String  @default("store-original")
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)
  key       String // "Material"
  value     String // "Aluminio"
  sortOrder Int     @default(0)

  @@unique([productId, key])
  @@index([storeId])
  @@map("product_specs")
}

model ProductVariant {
  storeId    String  @default("store-original")
  store      Store   @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)
  name       String // "Grafito", "Talla M"
  colorHex   String? // pastilla de color para la PDP ("#1f2937")
  sku        String?
  stock      Int     @default(0)
  priceDelta Decimal @default(0) @db.Decimal(10, 2) // ajuste sobre el precio del producto
  sortOrder  Int     @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([storeId, sku])
  @@unique([storeId, productId, id])
  @@unique([productId, name])
  @@unique([storeId, id])
  @@map("product_variants")
}

model Review {
  storeId   String   @default("store-original")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  title     String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@unique([productId, userId]) // una reseña por usuario y producto
  @@index([storeId])
  @@index([productId])
  @@map("reviews")
}

// ═══════════════════ Carrito y favoritos ═══════════════════

model Cart {
  storeId   String     @default("store-original")
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id        String     @id @default(cuid())
  userId    String? // carrito de usuario registrado
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String? // carrito anónimo (cookie de sesión)
  items     CartItem[]
  updatedAt DateTime   @updatedAt

  @@unique([storeId, id])
  @@unique([storeId, userId])
  @@unique([storeId, sessionId])
  @@index([userId])
  @@map("carts")
}

model CartItem {
  storeId   String          @default("store-original")
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [storeId, cartId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)
  productId String
  product   Product         @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)
  variantId String?
  variant   ProductVariant? @relation(fields: [storeId, productId, variantId], references: [storeId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  qty       Int             @default(1)

  @@unique([cartId, productId, variantId])
  @@index([storeId])
  @@map("cart_items")
}

model WishlistItem {
  storeId   String   @default("store-original")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)
  createdAt DateTime @default(now())

  @@id([storeId, userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ═══════════════════════════ Pedidos ═══════════════════════════

enum OrderStatus {
  PENDING // pendiente
  PAID // pagado
  PACKING // empacando
  SHIPPED // enviado
  IN_TRANSIT // en camino
  DELIVERED // entregado
  CANCELLED // cancelado
}

model Order {
  storeId String      @default("store-original")
  store   Store       @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id      String      @id @default(cuid())
  code    String      @unique // "TM-10241" (lo genera la app)
  userId  String? // null => compra de invitado
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status  OrderStatus @default(PENDING)

  // Snapshot de contacto y envío al momento de comprar (invitado o no):
  // la orden no cambia aunque el usuario edite su perfil después.
  email        String
  phone        String
  shippingName String
  street       String
  city         String
  state        String
  zip          String
  country      String  @default("México")
  reference    String?

  subtotal      Decimal @db.Decimal(10, 2)
  shippingCost  Decimal @default(0) @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)
  inventoryRestoredAt DateTime?

  // Rastreo del envío (lo fija el admin en /admin/orders/[id])
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  items       OrderItem[]
  payments    Payment[]
  events      OrderStatusEvent[]
  redemptions DiscountRedemption[]
  emails      EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, id])
  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  storeId   String          @default("store-original")
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)
  productId String? // SetNull: la orden sobrevive si el producto se borra
  product   Product?        @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Restrict, onUpdate: Restrict)
  variantId String?
  variant   ProductVariant? @relation(fields: [storeId, productId, variantId], references: [storeId, productId, id], onDelete: Restrict, onUpdate: Restrict)

  // Snapshot del producto al momento de la compra:
  name        String
  brand       String
  variantName String?
  unitPrice   Decimal  @db.Decimal(10, 2)
  /// Costo unitario al momento de la venta (snapshot). Así la ganancia histórica
  /// no cambia si luego cambia el costo del producto. `null` = venta previa a
  /// registrar costos.
  unitCost    Decimal? @db.Decimal(10, 2)
  qty         Int

  @@index([storeId])
  @@index([orderId])
  @@map("order_items")
}

/// Línea de tiempo del pedido (alimenta el stepper del admin y el rastreo del cliente).
model OrderStatusEvent {
  storeId   String      @default("store-original")
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)
  status    OrderStatus
  note      String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([storeId])
  @@index([orderId])
  @@map("order_status_events")
}

// ═══════════════════════════ Pagos ═══════════════════════════

enum PaymentMethod {
  CARD
  PAYPAL
  EFECTY // pago en efectivo en puntos Efecty
  TRANSFER
  PSE // débito desde cuenta bancaria (el método online más usado en Colombia)
  WOMPI // pasarela Wompi (tarjeta, PSE, Nequi… — el método real lo reporta Wompi)
  COD // contra entrega: efectivo al recibir el pedido
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

model Payment {
  storeId   String        @default("store-original")
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(10, 2)
  reference String? // id de pasarela / comprobante Efecty / referencia PSE
  gatewayReference String? @unique
  gatewayTransactionId String? @unique
  createdAt DateTime      @default(now())

  @@index([storeId])
  @@index([orderId])
  @@map("payments")
}

// ═══════════════════════ Descuentos ═══════════════════════

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
  GIFT_CARD
}

enum DiscountStatus {
  ACTIVE
  SCHEDULED
  EXPIRED
  DISABLED
}

model DiscountCode {
  storeId     String         @default("store-original")
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id          String         @id @default(cuid())
  code        String // "BIENVENIDO10"
  type        DiscountType
  value       Decimal        @default(0) @db.Decimal(10, 2) // % o monto según type
  minPurchase Decimal?       @db.Decimal(10, 2)
  usageLimit  Int? // null = ilimitado
  usedCount   Int            @default(0)
  balance     Decimal?       @db.Decimal(10, 2) // saldo restante (solo GIFT_CARD)
  status      DiscountStatus @default(ACTIVE)
  startsAt    DateTime?
  expiresAt   DateTime?
  description String?        @db.Text // nota interna ("campaña Buen Fin")
  createdAt   DateTime       @default(now())

  redemptions DiscountRedemption[]

  @@unique([storeId, id])
  @@unique([storeId, code])
  @@map("discount_codes")
}

/// Canje: qué orden usó qué código y cuánto descontó.
model DiscountRedemption {
  storeId   String       @default("store-original")
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id        String       @id @default(cuid())
  codeId    String
  code      DiscountCode @relation(fields: [storeId, codeId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)
  orderId   String
  order     Order        @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount    Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now())

  @@unique([codeId, orderId])
  @@index([storeId])
  @@map("discount_redemptions")
}

// ═══════════════ Contenido del landing y correos ═══════════════

enum BannerPlacement {
  HERO // carrusel principal
  HERO_SIDE // banner lateral del hero
  PROMO // tarjeta dentro de una sección de banners (grid)
  STRIP // franja ancha dentro de una sección de banners
}

model Banner {
  storeId   String          @default("store-original")
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id        String          @id @default(cuid())
  placement BannerPlacement
  /// Todo el texto es opcional: un banner puede ser solo la imagen.
  title     String?
  subtitle  String?
  highlight String? // "50% OFF"
  /// Texto del botón. Sin él no se pinta botón y el banner entero es el enlace.
  ctaText   String?
  /// Siempre obligatorio: es a donde lleva el clic sobre el banner.
  href      String
  imageUrl  String? // imagen de fondo (cuando exista)
  bgClass   String? // gradiente tailwind mientras no haya imagen
  sortOrder Int             @default(0)
  active    Boolean         @default(true)

  // HERO/HERO_SIDE viven en la sección HERO por su placement.
  // PROMO/STRIP pertenecen a una sección de banners concreta, lo que permite
  // colocarlos arriba o debajo de cualquier fila de productos.
  sectionId String?
  section   HomeSection? @relation(fields: [storeId, sectionId], references: [storeId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([storeId])
  @@index([placement, active])
  @@index([sectionId])
  @@map("banners")
}

// ═══════════════ Composición de la página de inicio ═══════════════

enum HomeSectionKind {
  HERO // carrusel + banners laterales
  CATEGORIES // círculos de categorías
  PRODUCTS // fila de productos (título + fuente)
  BANNERS // banners intercalados entre secciones
}

/// De dónde salen los productos de una sección PRODUCTS.
enum ProductSource {
  OFFERS // en oferta (mayor descuento primero)
  CATEGORY // una categoría concreta
  FEATURED // destacados
  NEWEST // más recientes
  TOP_RATED // mejor calificados
}

enum BannerLayout {
  GRID // tarjetas en rejilla (3 por fila)
  WIDE // franja ancha a todo lo largo
}

/// Dónde se coloca el banner destacado de una sección PRODUCTS.
enum SectionBannerPosition {
  LEFT // banner a la izquierda, productos a la derecha
  RIGHT // productos a la izquierda, banner a la derecha
  TOP // banner ancho encima de los productos
  BOTTOM // banner ancho debajo de los productos
}

/// Una sección de la home. El orden (`sortOrder`) define cómo se apilan,
/// así el admin puede poner banners arriba o debajo de cada fila de productos.
model HomeSection {
  storeId String          @default("store-original")
  store   Store           @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id      String          @id @default(cuid())
  kind    HomeSectionKind
  title   String? // encabezado visible (PRODUCTS)

  // Solo para PRODUCTS:
  source       ProductSource?
  categorySlug String?
  category     Category?      @relation(fields: [storeId, categorySlug], references: [storeId, slug], onDelete: Restrict, onUpdate: Restrict)
  maxItems     Int            @default(5)
  href         String? // destino de "Ver todo" (si null, se deriva)

  // Solo para BANNERS:
  bannerLayout BannerLayout?

  // Banners de la sección. En BANNERS son el contenido; en PRODUCTS son
  // banners destacados que se colocan junto a la fila según `bannerPosition`.
  banners Banner[]

  /// Posición del banner destacado dentro de una sección PRODUCTS.
  /// `null` = la fila no muestra banner destacado aunque tenga uno asignado.
  bannerPosition SectionBannerPosition?
  /// Fondo de la sección completa (clases tailwind), p.ej. una franja de color.
  /// Sirve de color de respaldo cuando hay `bgImageUrl`.
  bgClass        String?
  /// Imagen de fondo de la sección completa (campañas tipo "mundial").
  bgImageUrl     String?
  /// Oscurecido sobre la imagen de fondo (0-100) para que el texto se lea.
  bgOverlay      Int                    @default(0)

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, id])
  @@index([active, sortOrder])
  @@map("home_sections")
}

enum EmailType {
  ORDER_CONFIRMATION // historial de compra
  SHIPPING_UPDATE // estado + link de rastreo
  DELIVERY_CONFIRMATION
}

/// Registro de correos enviados al cliente desde el panel de pedidos.
model EmailLog {
  storeId          String    @default("store-original")
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id               String    @id @default(cuid())
  orderId          String?
  order            Order?    @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Restrict, onUpdate: Restrict)
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  to               String
  type             EmailType
  includedTracking Boolean   @default(false)
  sentAt           DateTime  @default(now())

  @@index([storeId])
  @@index([orderId])
  @@map("email_logs")
}

// ═══════════════ Avisos del panel ═══════════════

enum NotificationType {
  ORDER_CREATED // alguien compró
  SUPPORT_MESSAGE // llegó una PQR o un contacto
  REVIEW_CREATED // un comprador calificó un producto
  LOW_STOCK // una venta dejó un producto casi sin unidades
}

/// Avisos de la campana del panel.
///
/// Los escriben los servicios cuando ocurre algo (checkout, PQR, reseña) y los
/// lee el equipo. El estado de leído es COMPARTIDO: si un admin lo lee, queda
/// leído para todos, que es como funciona una bandeja de equipo.
model Notification {
  storeId  String           @default("store-original")
  store    Store            @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id       String           @id @default(cuid())
  type     NotificationType
  title    String
  body     String?          @db.Text
  /// A dónde lleva el clic, p.ej. /admin/orders/xxx
  href     String?
  /// Entidad relacionada. Evita repetir el mismo aviso (p.ej. el stock bajo de
  /// un producto del que ya avisamos y nadie ha leído todavía).
  entityId String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([storeId])
  @@index([readAt, createdAt])
  @@index([type, entityId])
  @@map("notifications")
}

// ═══════════════ PQR y contacto ═══════════════

enum SupportKind {
  PETICION
  QUEJA
  RECLAMO
  SUGERENCIA
  CONTACTO // mensaje libre desde "Contáctanos"
}

enum SupportStatus {
  NUEVO
  EN_PROCESO
  RESUELTO
  CERRADO
}

/// Mensajes de PQR y de contacto que llegan desde la tienda.
///
/// En Colombia una PQR tiene plazos legales de respuesta, así que cada mensaje
/// lleva radicado propio y estado. Hoy la respuesta queda registrada en el panel:
/// no sale ningún correo porque la tienda todavía no tiene SMTP configurado.
model SupportMessage {
  storeId  String        @default("store-original")
  store    Store         @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id       String        @id @default(cuid())
  /// Número visible para el cliente, p.ej. PQR-2026-000123.
  radicado String        @unique
  kind     SupportKind
  status   SupportStatus @default(NUEVO)

  name      String
  email     String
  phone     String?
  /// Cédula o NIT: opcional, pero habitual en una PQR formal.
  docId     String?
  /// Pedido relacionado (código VLP-xxxxx), si aplica.
  orderCode String?

  subject String
  message String @db.Text

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Respuesta del equipo, registrada desde el panel.
  response    String?   @db.Text
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([status, createdAt])
  @@index([kind])
  @@map("support_messages")
}
